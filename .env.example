# ---------- Database ----------
DATABASE_URL=postgresql://resto:resto@127.0.0.1:5432/restoapp

# ---------- API ----------
API_PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Comma separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Public base URL of the customer web app; used to build QR code links
PUBLIC_WEB_URL=http://localhost:3000

# ---------- Seed admin (only used by `npm run db:seed`) ----------
SEED_ADMIN_EMAIL=admin@restoapp.local
SEED_ADMIN_PASSWORD=admin12345

# ---------- Kitchen printing ----------
# none  -> only store print jobs (browser printing via /print pages)
# escpos-> also stream ESC/POS bytes to a network thermal printer
PRINTER_DRIVER=none
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_CHARS_PER_LINE=42

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
