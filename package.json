{
  "name": "restoapp",
  "private": true,
  "version": "1.0.0",
  "description": "QR-based cafe table ordering, kitchen printing, supervisor billing and admin platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "start:web": "npm run start --workspace apps/web",
    "db:migrate": "npm run migrate --workspace apps/api",
    "db:seed": "npm run seed --workspace apps/api",
    "db:reset": "npm run reset --workspace apps/api",
    "test": "npm run test --workspace apps/api",
    "doctor": "npm run doctor --workspace apps/api --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.49.1"
  }
}